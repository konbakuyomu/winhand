<Window
    x:Class="Winhand.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="winhand">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <muxc:NavigationView x:Name="RootNavigation"
                         PaneDisplayMode="Left"
                         OpenPaneLength="216"
                         IsPaneToggleButtonVisible="False"
                         IsTitleBarAutoPaddingEnabled="False"
                         AlwaysShowHeader="False"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False"
                         SelectionChanged="OnNavigationSelectionChanged">
      <muxc:NavigationView.PaneFooter>
        <Grid Height="160" />
      </muxc:NavigationView.PaneFooter>
      <muxc:NavigationView.MenuItems>
        <muxc:NavigationViewItem Content="概览" Tag="overview" IsSelected="True">
          <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
        <muxc:NavigationViewItem Content="活动" Tag="activity">
          <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
        <muxc:NavigationViewItem Content="会话" Tag="sessions">
          <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE756;" /></muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
        <muxc:NavigationViewItem Content="MCP 服务" Tag="mcp">
          <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
        <muxc:NavigationViewItem Content="设置" Tag="settings">
          <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
      </muxc:NavigationView.MenuItems>
      <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="52" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="24,0">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PageTitle" Text="概览" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <!-- Operation messages live behind this button: they never push the page content around. -->
            <Button x:Name="FeedbackButton" Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}"
                    IsEnabled="False" AutomationProperties.Name="操作提示" ToolTipService.ToolTip="操作提示">
              <FontIcon x:Name="FeedbackIcon" Glyph="&#xE8BD;" FontSize="16" />
              <Button.Flyout>
                <Flyout x:Name="FeedbackFlyout" Placement="BottomEdgeAlignedRight">
                  <StackPanel Width="360" Spacing="8">
                    <TextBlock x:Name="FeedbackTitle" Style="{StaticResource LabelCopyStyle}" />
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                      <TextBlock x:Name="FeedbackMessage" Style="{StaticResource BodyCopyStyle}" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                      <Button x:Name="FeedbackAction" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                      <Button x:Name="FeedbackClear" Content="清除提示" />
                    </StackPanel>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <ContentControl x:Name="HeaderStatus" Grid.Column="2" Style="{StaticResource StatusNeutralStyle}" Content="启动中" />
          </Grid>
        </Border>
        <ContentControl x:Name="PageHost" Grid.Row="1"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Grid>
    </muxc:NavigationView>
    <Grid Width="216" Height="160" HorizontalAlignment="Left" VerticalAlignment="Bottom">
      <Grid IsHitTestVisible="False">
        <Grid.Clip><RectangleGeometry Rect="0,0,216,160" /></Grid.Clip>
        <Image Source="ms-appx:///Assets/mascot.png" Width="168" Height="168"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Uniform"
               AutomationProperties.AccessibilityView="Raw">
          <Image.RenderTransform><TranslateTransform Y="16" /></Image.RenderTransform>
        </Image>
      </Grid>
      <Grid Width="24" Height="24" Margin="0,0,8,8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent">
        <ToolTipService.ToolTip>
          <ToolTip x:Name="ConnectionToolTip" Placement="Top" />
        </ToolTipService.ToolTip>
        <Ellipse x:Name="ConnectionDot" Style="{StaticResource ConnectionIdleStyle}" HorizontalAlignment="Center" />
      </Grid>
    </Grid>
  </Grid>
</Window>
